# synthetic test fixture under tests/fixture/ is tracked.
knxprod/
knxprod-index/
data/
*.knxprod
*.zip
*.xml.gz
*.tmp
knx_master.xml
Hardware.xml
Catalog.xml
Baggages.xml
M-*_A-*.xml
*.signature
!tests/fixture/**
